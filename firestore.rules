rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Basic shape check, not a content check — this exists to reject a
    // completely malformed write (a client bug, or eventually a second
    // client like the planned iOS app getting a field wrong), not to
    // enforce every detail of what's inside roster/settings. Those keep
    // evolving (e.g. keeperShiftMinutes is optional and often blank), so
    // this deliberately only checks that the required top-level fields
    // exist and are the right *kind* of thing.
    function isValidTeam(data) {
      return data.keys().hasAll(['name', 'roster', 'settings', 'ownerId', 'memberIds'])
        && data.name is string
        && data.roster is list
        && data.settings is map
        && data.ownerId is string
        && data.memberIds is list
        && data.memberIds.size() > 0;
    }

    function isValidMatchState(data) {
      return data.keys().hasAll(['plan', 'activeInterval'])
        && data.plan is list
        && data.activeInterval is number;
    }

    match /teams/{teamId} {
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && isValidTeam(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && isValidTeam(request.resource.data);

      match /matchState/{stateId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
        allow write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
          && isValidMatchState(request.resource.data);
      }
    }

    // Crash reports: write-only from the client's point of view. Anyone can
    // file one, even signed out (a crash on the sign-in screen itself should
    // still be reportable), but nobody — not even the person who filed it —
    // can read, change, or delete one back through the app. They're only
    // ever visible via the Firebase console, which authenticates as the
    // project owner and doesn't go through these rules at all.
    match /crashReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
