rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Basic shape check, not a content check — this exists to reject a
    // completely malformed write (a client bug, or eventually a second
    // client like the planned iOS app getting a field wrong), not to
    // enforce every detail of what's inside roster/settings. Those keep
    // evolving (e.g. keeperShiftMinutes is optional and often blank), so
    // this deliberately only checks that the required top-level fields
    // exist and are the right *kind* of thing.
    function isValidTeam(data) {
      return data.keys().hasAll(['name', 'roster', 'settings', 'ownerId', 'memberIds'])
        && data.name is string
        && data.roster is list
        && data.settings is map
        && data.ownerId is string
        && data.memberIds is list
        && data.memberIds.size() > 0;
    }

    function isValidMatchState(data) {
      return data.keys().hasAll(['plan', 'activeInterval'])
        && data.plan is list
        && data.activeInterval is number;
    }

    // Match Link — shape check only, same spirit as isValidTeam/
    // isValidMatchState above: reject a malformed write, don't police every
    // detail of claim's contents (claim itself is allowed to be null — no
    // one has claimed it yet).
    function isValidHandover(data) {
      return data.keys().hasAll(['level', 'createdAt', 'createdBy', 'stopsAtFullTime', 'expiresAt', 'revokedAt', 'requireEmailClaim', 'claimToken'])
        && data.level in ['subs', 'full']
        && data.stopsAtFullTime is bool
        && data.requireEmailClaim is bool
        && data.claimToken is string;
    }

    function isMember(teamId) {
      return request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }

    // Match Link — shared by both matchHandover and matchState below, so
    // this is the ONE place either has to change. Mirrors
    // src/lib/matchHandover.js's isHandoverActive exactly (same four
    // checks, same order) — if that file's logic changes, this needs the
    // equivalent change alongside it, and vice versa.
    //
    // exists() guards every get() below it: a team with no handover yet —
    // the common case — must not make every matchState access error out.
    function handoverExists(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId)/matchHandover/current);
    }
    function handoverDoc(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/matchHandover/current).data;
    }
    function isHandoverActive(teamId) {
      return handoverExists(teamId)
        && handoverDoc(teamId).revokedAt == null
        && (handoverDoc(teamId).expiresAt == null || request.time.toMillis() < handoverDoc(teamId).expiresAt)
        && handoverDoc(teamId).claim != null
        && handoverDoc(teamId).claim.revokedAt == null;
    }
    function isActiveHolder(teamId) {
      return isHandoverActive(teamId) && request.auth.uid == handoverDoc(teamId).claim.claimedByUid;
    }

    match /teams/{teamId} {
      // Step 5 — a parent's MatchView needs the roster (player names/shirt
      // numbers) and team name, same as the coach's own screen, but a
      // parent is never a member. Read only (not delete): mirrors the
      // exact isMember(teamId) || isActiveHolder(teamId) pattern matchState
      // already uses. isActiveHolder(teamId) itself already only reads
      // teams/{teamId} to check membership nowhere — it keys off the
      // sibling matchHandover doc instead, so this doesn't create a
      // circular read.
      allow read: if request.auth != null && (request.auth.uid in resource.data.memberIds || isActiveHolder(teamId));
      allow delete: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && isValidTeam(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && isValidTeam(request.resource.data);

      // Match Link — a handover session lets one holder (usually a parent)
      // act on a team's current match without being a team member at all.
      match /matchHandover/{handoverId} {
        // Step 4 — MatchClaimPage (2b) has to read this doc BEFORE any
        // claim exists, to know whether to show the email form or attempt
        // a direct claim, and whether the link is already dead — none of
        // which a brand-new parent (not a member, not yet a holder) could
        // see under the original isMember/isActiveHolder-only read gate.
        // Stage A/B writes stay blind by design (no read needed to write —
        // see the update rules below), but a read genuinely has no
        // equivalent trick: there's no "prove you know the token" a get()
        // request can carry.
        //
        // Opened to any authenticated caller instead (this app auto-signs
        // everyone in anonymously on first visit — see AuthGate.jsx — so in
        // practice this means anyone at all). The practical gate becomes
        // teamId itself: a 20-char unguessable Firestore auto-id, not
        // discoverable without already having a real share link. Writes are
        // UNCHANGED — still exactly as tightly scoped as Steps 1-2 built.
        //
        // Accepted trade-off, not an oversight: a past holder's email stays
        // readable to anyone who ever had that link and still knows teamId,
        // even after revocation — revoking a holder clears neither
        // claim.email nor claim itself, only sets claim.revokedAt.
        allow read: if request.auth != null;

        // The coach: full create/update, unchanged from Step 1.
        allow create, update: if request.auth != null && isMember(teamId) && isValidHandover(request.resource.data);

        // Step 2 — the two-stage claim, open to ANY authenticated caller
        // (never a team member check; this is exactly how a parent with no
        // account gets in at all). Neither branch needs read access first —
        // request.resource.data.diff(resource.data) lets a rule compare
        // what's being written against what's already stored without the
        // caller ever having read it.
        //
        // The security question both branches answer is "does this caller
        // actually have the real token, or are they guessing?" — proven by
        // requiring the SAME value to appear in both request.resource.data
        // (what they're submitting right now) and resource.data (what's
        // already stored). This only works because pendingClaim/claim are
        // whole-map replacements in these updates, not deep merges — a
        // plain nested-object value in updateDoc() replaces the entire map,
        // it does not merge field-by-field into it, so viaToken here can
        // never silently inherit a stale value the caller never actually
        // submitted.
        //
        // Stage A (requireEmailClaim on): submit an email, get a
        // pendingClaim carrying a fresh, single-use deviceToken — this is
        // the token Pile 2 (the email-sending piece, not built yet) will
        // actually deliver. A fresh request can supersede an existing
        // pending one (whoever has the freshest link wins), but never a
        // completed claim.
        allow update: if request.auth != null
          && resource.data.claim == null
          && resource.data.revokedAt == null
          && (resource.data.expiresAt == null || request.time.toMillis() < resource.data.expiresAt)
          && resource.data.requireEmailClaim == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingClaim'])
          && request.resource.data.pendingClaim.viaToken == resource.data.claimToken
          && request.resource.data.pendingClaim.email is string
          && request.resource.data.pendingClaim.deviceToken is string
          && isValidHandover(request.resource.data);

        // Stage B: confirm via the emailed deviceToken (requireEmailClaim
        // on) or directly via claimToken (requireEmailClaim off, where
        // Stage A and B are the same write — there is no pendingClaim step
        // at all in that case). Either way this is the one write that sets
        // claim.claimedByUid == request.auth.uid, which is what
        // isActiveHolder() everywhere else keys on.
        allow update: if request.auth != null
          && resource.data.claim == null
          && resource.data.revokedAt == null
          && (resource.data.expiresAt == null || request.time.toMillis() < resource.data.expiresAt)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claim', 'pendingClaim'])
          && request.resource.data.pendingClaim == null
          && request.resource.data.claim.claimedByUid == request.auth.uid
          && isValidHandover(request.resource.data)
          && (
               (resource.data.requireEmailClaim == true
                 && resource.data.pendingClaim != null
                 && request.resource.data.claim.viaToken == resource.data.pendingClaim.deviceToken)
               || (resource.data.requireEmailClaim == false
                 && request.resource.data.claim.viaToken == resource.data.claimToken)
             );
      }

      match /matchState/{stateId} {
        // The three fields that make up "the clock" — see useMatchState.js's
        // own save effect for this exact list. Everything else in
        // matchState (subs, injuries, swaps, keeper changes) is the shared,
        // concurrent write path checked by the base allow-write condition
        // below; only these three are exclusive.
        function clockFieldsChanged() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['baseElapsedSec', 'runStartedAt', 'timerRunning']);
        }
        // Unconditional on the handover's `level` — level is display-only
        // (see matchHandover.js). Whoever holds an active claim owns the
        // clock; the coach does not, for as long as it's active. Real-use
        // correction: a "subs" level handover still moves clock ownership,
        // exactly like "full" does — there is no split state where the
        // parent has subs and the coach still has the clock.
        function isClockOwner() {
          return isHandoverActive(teamId) ? isActiveHolder(teamId) : isMember(teamId);
        }

        allow read: if request.auth != null && (isMember(teamId) || isActiveHolder(teamId));
        allow write: if request.auth != null
          && isValidMatchState(request.resource.data)
          && (isMember(teamId) || isActiveHolder(teamId))
          && (!clockFieldsChanged() || isClockOwner());
      }

      // One document per completed, archived game (season history) — kept
      // deliberately loose on content shape (membership check only, no
      // per-field validation the way teams/matchState get). What's inside
      // a game record is expected to grow over time (e.g. a player
      // position, once that's built) without needing a rules change every
      // time a new field is added to what gets snapshotted per player.
      match /games/{gameId} {
        allow read, write: if request.auth != null && isMember(teamId);
      }
    }

    // Crash reports: write-only from the client's point of view. Anyone can
    // file one, even signed out (a crash on the sign-in screen itself should
    // still be reportable), but nobody — not even the person who filed it —
    // can read, change, or delete one back through the app. They're only
    // ever visible via the Firebase console, which authenticates as the
    // project owner and doesn't go through these rules at all.
    match /crashReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
