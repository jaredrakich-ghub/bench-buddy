  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "firebase-tools": "^15.26.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
